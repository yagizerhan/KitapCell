# ==========================================
# KitapCell - Root .gitignore
# ==========================================

# Word documents & reports (local use only)
*.docx
*.doc
*.xlsx
*.xls
*.pptx

# Markdown notes & reports (local use only)
Vize_Raporu_Metinleri.md
calibre_ozellik_listesi.md
vize_raporu_*.docx

# Derlenmiş installer (çok büyük - 75MB+)
*.exe
*.msi

# Inno Setup output folder
Output/

# Visual Studio / Rider temporary files
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
.idea/

# .NET build outputs
**/bin/
**/obj/

# SQLite database (contains personal data, recreated automatically via EF Migrations)
*.db
*.db-shm
*.db-wal

# Kullanıcı yüklenen profil resimleri
**/ProfileImages/

# Çalışma zamanı ayarları
settings.json

# OS dosyaları
.DS_Store
Thumbs.db
desktop.ini

# Log dosyaları
*.log

# NuGet paket önbelleği
packages/
*.nupkg

# Prototype (old experiments)
prototype/
